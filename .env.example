# Copy this file to backend/.env and fill in values as needed.
# ManakAI runs fully in Demo Mode with NO values set below.

# --- Optional LLM configuration ---
# If ANTHROPIC_API_KEY is left empty, ManakAI automatically falls back
# to Demo Mode (keyword-matched, pre-verified template answers), so the
# app never breaks during a live demo.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
